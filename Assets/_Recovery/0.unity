  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Meet Amelia, a bouncy and curious Cavapoo puppy who hasn\u2019t quite
    figured out why going potty outside is such a big deal. What she does know is
    that making her family happy is her favorite thing. Her family\u2019s busy schedule
    means breakfast at 9 AM, lunch at 1 PM, and dinner at 5 PM, with days starting
    bright and early at 6 and winding down at 10.\n\nYour mission: help Amelia find
    the perfect potty schedule! Too many trips outside, and she\u2019ll be missing
    out on playtime and cuddles. Too few, and, well\u2026 let\u2019s just say her
    family\u2019s rugs are at risk.\n\nCan you strike the magical balance to keep
    Amelia wagging and accident-free? Let\u2019s get started. Amelia is counting
    on you!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
